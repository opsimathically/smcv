# SMCV production configuration contains no secret values.
SMCV_ENVIRONMENT=production
SMCV_LISTEN_ADDR=127.0.0.1:8080
SMCV_METRICS_ADDR=127.0.0.1:9090
SMCV_DATA_DIR=/var/lib/smcv
SMCV_KEY_DIR=/var/lib/smcv-key
SMCV_RP_ID=vault.example.test
SMCV_ORIGIN=https://vault.example.test
SMCV_PROTECTED_TRANSPORT=1
SMCV_LOG_FORMAT=json
SMCV_SHUTDOWN_GRACE_SECONDS=15

# Optional direct local-lab HTTPS. Choose one exact LAN address and DNS name.
# With no certificate paths, SMCV persists a self-signed pair in SMCV_KEY_DIR.
# SMCV_LAB_HTTPS_ADDR=192.168.50.10:8443
# SMCV_LAB_HTTPS_SERVER_NAME=vault.lab.example
# Optional paired absolute paths for a CA-issued PEM chain and private key:
# SMCV_LAB_HTTPS_CERT_FILE=/var/lib/smcv-key/lab-https-chain.pem
# SMCV_LAB_HTTPS_KEY_FILE=/var/lib/smcv-key/lab-https-key.pem
